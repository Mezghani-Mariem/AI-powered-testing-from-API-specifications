# Groq example: base URL must include /openai/v1, without /chat/completions.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
# Set a model available in your provider account.
LLM_MODEL=
LLM_TEMPERATURE=0
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
# json_object, json_schema (provider dependent), or none
LLM_RESPONSE_FORMAT=json_object
LLM_MAX_TOKENS=4096

